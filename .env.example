# Cogni-RSI local config — copy to .env and fill in.

# LLM (minimax-m3 via OpenAI-compatible endpoint)
MINIMAX_API_KEY=
COGNI_LLM_BASE_URL=https://api.minimax.chat/v1
COGNI_LLM_MODEL=minimax-m3

# Safety gate: NEVER set to 1 unless you really mean it.
COGNI_ALLOW_WRITE=0

# Local sources
COGNI_DOC_ROOT=./docs
COGNI_CODE_ROOT=./target-saas

# SQLite persistence
COGNI_DB_URL=sqlite://nodb.db